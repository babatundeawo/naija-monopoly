{
  "name": "naija-monopoly",
  "version": "1.0.0",
  "description": "Naija Monopoly - Wealth Wahala Edition, a Nigerian-themed Monopoly game",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.naijamonopoly",
    "productName": "Naija Monopoly",
    "files": [
      "index.html",
      "main.js",
      "icon.png"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
