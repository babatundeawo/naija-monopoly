{
  "name": "naija-monopoly",
  "version": "1.1.0",
  "description": "Naija Monopoly - Wealth Wahala Edition, a Nigerian-themed Monopoly game",
  "main": "main.js",
  "author": "babatundeawo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.naijamonopoly",
    "productName": "Naija Monopoly",
    "files": [
      "src/**/*",
      "main.js",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "homepage": "https://github.com/babatundeawo/naija-monopoly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babatundeawo/naija-monopoly.git"
  }
}
